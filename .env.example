# ==============================================================================
# QuantaFlow Environment Configuration
# ==============================================================================

# Database Configuration (PostgreSQL 16 & Embedded DuckDB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=quantaflow
POSTGRES_USER=quantaflow
POSTGRES_PASSWORD=changeme
ENGINE_MODE=auto

# MinIO / AWS S3 Object Storage
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=quantaflow
MINIO_SECRET_KEY=changeme123
MINIO_BUCKET=quanta-flow

# Apache Airflow Service Credentials
AIRFLOW_UID=50000
AIRFLOW_GID=0

# Pipeline Execution Boundaries & Environment
ENVIRONMENT=production
PIPELINE_VERSION=1.2.0
DATA_INTERVAL_START=2024-01
DATA_INTERVAL_END=2024-06

# Secret Management & Offline Fixtures
AWS_SECRETS_PREFIX=quantaflow/prod
SECRETS_DIR=./secrets
QUANTAFLOW_OFFLINE_FIXTURES_DIR=./tests/fixtures

# Observability, Webhook Alerts & Error Tracking
ALERT_WEBHOOK_URL=
SENTRY_DSN=

# Pipeline Storage & Partition Directories
MANIFEST_DIR=data/manifests
SAMPLE_DIR=data/samples
BRONZE_DIR=data/bronze
SILVER_DIR=data/silver
GOLD_DIR=data/gold
QUARANTINE_DIR=data/quarantine
REPORTS_DIR=data/reports

# Domain Sensory Parameters
WEATHER_STATION_ID=USW00094728
ROW_COUNT_CHANGE_THRESHOLD=0.30
